{
  "name": "dsh-whale-sync",
  "version": "0.2.0",
  "description": "DeepSeek Harness 一键同步插件:页面左下角「⟳ 同步」按钮,把会话/设置/API密钥/插件/技能同步到你的 GitHub 私有仓库,支持会话删除",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sync"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpskk2/dsh-whale-sync.git"
  },
  "bugs": {
    "url": "https://github.com/dpskk2/dsh-whale-sync/issues"
  },
  "homepage": "https://github.com/dpskk2/dsh-whale-sync#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
